
---
import "../styles/hero.css";
---

<section class="hero">
  <div class="hero-main">
    <h1 class="hero-title">
      <span class="hero-first-line">
        <span class="hero-word">Hope</span>

        <span class="hero-image">
            <img
                src="/images/image-1.jfif"
                alt="A woman supporting a loved one"
            />
        </span>

        <span class="hero-word">Rise</span>
      </span>

      <span class="hero-second-line">is Support</span>
    </h1>

    <div class="hero-actions">
      <a href="/donate" class="hero-donate">DONATE</a>

      <a href="/get-involved" class="help-link">I NEED HELP</a>

      <a href="/get-involved" class="help-arrow" aria-label="Find help">
        ↗
      </a>
    </div>
  </div>

  <div class="partner-strip">
    <a href="/donate" class="quick-donate">
      <span class="round-icon" aria-hidden="true">⊞</span>
      <span>QUICK DONATE</span>
    </a>

    <div class="partners" aria-label="Community partners">
      <span class="partner-gofundme">gofundme<span>✳</span></span>

      <span class="partner-cancer">
        <span class="cancer-symbol">◉</span>
        <span>CANCER<br />RESEARCH<br />UK</span>
      </span>

      <span class="partner-medtronic">Medtronic</span>
    </div>

    <a href="#more-content" class="scroll-down">
      <span>SCROLL DOWN</span>
      <span class="round-icon scroll-icon" aria-hidden="true">↓</span>
    </a>
  </div>
</section>
