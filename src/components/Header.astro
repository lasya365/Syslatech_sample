---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="SYSLATECH home">
      <img
        class="slide-logo"
        src="https://syslatech.com/Images/Logo.png"
        alt="SYSLATECH"
        />
        <span class="brand-line"></span>
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" aria-label="Main navigation">
      {menus.map((menu) => (
        <div class="nav-item" data-menu={menu.key}>
          <button
            class="nav-link dropdown-trigger"
            type="button"
            aria-expanded="false"
          >
            {menu.label}
            <svg
              class="chevron"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class={`mega-menu mega-menu-${menu.key}`}>
            <div class="mega-menu-heading">
              <span>{menu.label}</span>
              <span class="menu-subtitle">Explore our {menu.label.toLowerCase()}</span>
            </div>

            <div class="mega-grid">
              {menu.items.map((item) => (
                <a class="mega-card" href={item.href} target="_blank" rel="noopener noreferrer">
                  
                  <div class="card-icon">
                    {menu.key === "tools" ? (
                    <img src={item.imageUrl} alt="" loading="lazy" />
                    ) : menu.key === "solutions" ? (
                    <img src={item.icon} alt="" loading="lazy" />
                    ) : (
                    <img src={item.image} alt="" loading="lazy" />
                    )}
                  </div>
                  <div class="card-content">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                  <span class="card-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <a class="nav-link contact-link" href="/contact/">
        Contact
      </a>
    </nav>
  </div>
</header>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e7ebf2;
    font-family: Arial, Helvetica, sans-serif;
  }


  .header-inner {
    width: min(1440px, 100%);
    min-height: 86px;
    margin: 0 auto;
    padding: 0 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
  }

  
  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-shrink: 0;
    width: 190px;
    text-decoration: none;
  }

  .slide-logo {
    display: block;
    width: 180px;
    max-width: 100%;
    height: 43px;
    object-fit: contain;
    object-position: left center;
  }

  .brand-line {
    width: 58%;
    height: 3px;
    margin-top: 4px;
    border-radius: 5px;
    background: #1684e8;
  }


  .main-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .nav-item {
    position: static;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 10px 12px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #17243a;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-link:hover,
  .nav-item.open > .nav-link,
  .nav-item:focus-within > .nav-link {
    color: #0878d1;
    background: #f0f7ff;
  }

  .chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .nav-item:hover .chevron,
  .nav-item.open .chevron,
  .nav-item:focus-within .chevron {
    transform: rotate(180deg);
  }

  /* Large dropdown panel */
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    padding: 27px max(5%, calc((100% - 1300px) / 2)) 32px;
    background: #ffffff;
    border-top: 1px solid #edf0f5;
    border-bottom: 1px solid #dce5ef;
    box-shadow: 0 18px 35px rgba(18, 44, 78, 0.13);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
  }

  .nav-item:hover > .mega-menu,
  .nav-item:focus-within > .mega-menu,
  .nav-item.open > .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mega-menu-heading {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin: 0 0 19px;
    color: #153c70;
    font-size: 20px;
    font-weight: 700;
  }

  .menu-subtitle {
    color: #7a8798;
    font-size: 12px;
    font-weight: 400;
  }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13px;
  }

  .mega-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 13px;
    min-width: 0;
    min-height: 112px;
    padding: 17px 32px 17px 16px;
    border: 1px solid #e4eaf2;
    border-radius: 10px;
    background: #ffffff;
    color: #24334a;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .mega-card:hover,
  .mega-card:focus-visible {
    border-color: #7dbcf5;
    background: #f8fbff;
    box-shadow: 0 8px 20px rgba(22, 100, 180, 0.1);
    transform: translateY(-3px);
    outline: none;
  }

  .card-icon {
    display: flex;
    flex: 0 0 43px;
    align-items: center;
    justify-content: center;
    width: 43px;
    height: 43px;
    overflow: hidden;
    border-radius: 9px;
    background: #edf6ff;
  }

  .card-icon img {
    display: block;
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-content h3 {
    margin: 1px 0 7px;
    color: #183a68;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .mega-card:hover h3 {
    color: #0878d1;
  }

  .card-content p {
    margin: 0;
    color: #69778b;
    font-size: 12px;
    line-height: 1.65;
  }

  .card-arrow {
    position: absolute;
    top: 13px;
    right: 13px;
    color: #94a6bb;
    font-size: 15px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .mega-card:hover .card-arrow {
    color: #0878d1;
    transform: translate(2px, -2px);
  }

  .mobile-toggle {
    display: none;
    width: 43px;
    height: 43px;
    padding: 10px;
    border: 1px solid #e0e7f0;
    border-radius: 7px;
    background: #ffffff;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    margin: 4px 0;
    border-radius: 2px;
    background: #153c70;
  }

  /* Tablet */
  @media (max-width: 1100px) {
    .header-inner {
      gap: 15px;
      padding: 0 3%;
    }

    .brand {
      font-size: 22px;
    }

    .main-nav {
      gap: 0;
    }

    .nav-link {
      gap: 4px;
      padding: 10px 8px;
      font-size: 12px;
    }

    .mega-menu {
      padding-right: 3%;
      padding-left: 3%;
    }

    .mega-card {
      gap: 10px;
      padding: 13px 27px 13px 12px;
    }
  }

  /* Mobile navigation */
  @media (max-width: 760px) {
    .header-inner {
      position: relative;
      min-height: 72px;
      padding: 0 20px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .brand {
      font-size: 23px;
    }

    .mobile-toggle {
      display: block;
      margin-left: auto;
    }

    .main-nav {
      display: none;
      flex: 0 0 100%;
      width: 100%;
      padding: 8px 0 18px;
      align-items: stretch;
      flex-direction: column;
      gap: 3px;
    }

    .main-nav.mobile-open {
      display: flex;
    }

    .nav-item {
      width: 100%;
    }

    .nav-link {
      display: flex;
      justify-content: space-between;
      width: 100%;
      min-height: 45px;
      padding: 12px;
      font-size: 14px;
      text-align: left;
    }

    .contact-link {
      justify-content: flex-start;
    }

    .mega-menu {
      position: static;
      display: none;
      width: 100%;
      max-height: 55vh;
      overflow-y: auto;
      padding: 12px 0 15px;
      border: 0;
      border-radius: 8px;
      background: #f7faff;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition: none;
    }

    .nav-item.open > .mega-menu {
      display: block;
    }

    .nav-item:hover > .mega-menu,
    .nav-item:focus-within > .mega-menu {
      transform: none;
    }

    .mega-menu-heading {
      display: block;
      margin: 0 0 12px;
      padding: 0 10px;
      font-size: 16px;
    }

    .menu-subtitle {
      display: block;
      margin-top: 5px;
    }

    .mega-grid {
      grid-template-columns: 1fr;
      gap: 9px;
      padding: 0 5px;
    }

    .mega-card {
      min-height: 90px;
      padding: 13px 30px 13px 12px;
      background: #ffffff;
    }

    .card-icon {
      flex-basis: 39px;
      width: 39px;
      height: 39px;
    }

    .card-icon img {
      width: 27px;
      height: 27px;
    }

    .card-content h3 {
      font-size: 13px;
    }

    .card-content p {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .chevron,
    .mega-menu,
    .mega-card,
    .card-content h3,
    .card-arrow {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector(".site-header");
  const mobileToggle = header?.querySelector(".mobile-toggle");
  const mainNav = header?.querySelector(".main-nav");
  const navItems = header?.querySelectorAll(".nav-item");

  mobileToggle?.addEventListener("click", () => {
    const isOpen = mainNav?.classList.toggle("mobile-open") ?? false;
    mobileToggle.setAttribute("aria-expanded", String(isOpen));
  });

  navItems?.forEach((item) => {
    const trigger = item.querySelector(".dropdown-trigger");

    trigger?.addEventListener("click", (event) => {
      event.stopPropagation();

      const wasOpen = item.classList.contains("open");

      navItems.forEach((otherItem) => {
        otherItem.classList.remove("open");
        otherItem
          .querySelector(".dropdown-trigger")
          ?.setAttribute("aria-expanded", "false");
      });

      if (!wasOpen) {
        item.classList.add("open");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !header?.contains(event.target)) {
      navItems?.forEach((item) => {
        item.classList.remove("open");
        item
          .querySelector(".dropdown-trigger")
          ?.setAttribute("aria-expanded", "false");
      });
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      navItems?.forEach((item) => {
        item.classList.remove("open");
        item
          .querySelector(".dropdown-trigger")
          ?.setAttribute("aria-expanded", "false");
      });

      mainNav?.classList.remove("mobile-open");
      mobileToggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>