
---
import "../styles/solutions.css";

const solutions = [
  {
    title: "Web Testing",
    description:
      "Reliable, secure, and scalable web testing for seamless user experiences.",
    icon: "web",
    href: "/solutions/Web-testing.html",
  },
  {
    title: "Mobile Testing",
    description:
      "Test mobile applications across devices and platforms for smooth, consistent performance.",
    icon: "mobile",
    href: "/solutions/Mobile-testing.html",
  },
  {
    title: "API Testing",
    description:
      "Validate APIs for functionality, reliability, security, and performance.",
    icon: "api",
    href: "/solutions/API-testing.html",
  },
  {
    title: "Desktop Testing",
    description:
      "Improve the quality of desktop applications through comprehensive testing.",
    icon: "desktop",
    href: "/solutions/Desktop-testing.html",
  },
  {
    title: "Salesforce Testing",
    description:
      "Verify Salesforce workflows, integrations, and business applications.",
    icon: "salesforce",
    href: "/solutions/Salesforce-testing.html",
  },
  {
    title: "Database Testing",
    description:
      "Check database accuracy, consistency, integrity, and reliability.",
    icon: "database",
    href: "/solutions/Database-testing.html",
  },
] as const;

const icons = {
  web: '<circle cx="24" cy="24" r="17"/><ellipse cx="24" cy="24" rx="8" ry="17"/><path d="M7 24h34M11 14h26M11 34h26"/>',
  mobile: '<rect x="12" y="4" width="24" height="40" rx="3"/><path d="M19 10h10M21 37h6"/><rect x="19" y="16" width="4" height="4"/><rect x="26" y="16" width="4" height="4"/><rect x="19" y="23" width="4" height="4"/><rect x="26" y="23" width="4" height="4"/>',
  api: '<circle cx="24" cy="24" r="5"/><circle cx="24" cy="7" r="4"/><circle cx="39" cy="16" r="4"/><circle cx="39" cy="32" r="4"/><circle cx="24" cy="41" r="4"/><circle cx="9" cy="32" r="4"/><circle cx="9" cy="16" r="4"/><path d="M24 12v7m11-1-7 4m7 9-7-4m-4 10v-7m-11 1 7-4m-7-15 7 4"/>',
  desktop: '<rect x="4" y="6" width="40" height="29" rx="2"/><path d="M18 42h12M24 35v7M9 12h30M10 17h28v13H10z"/>',
  salesforce: '<path d="M15 15a9 9 0 0 1 16-4 9 9 0 0 1 10 12 9 9 0 0 1-6 15H13a9 9 0 0 1-5-16 9 9 0 0 1 7-7z"/><path d="M16 23h16M18 28h12M20 33h8"/>',
  database: '<ellipse cx="24" cy="10" rx="16" ry="6"/><path d="M8 10v28c0 3 7 6 16 6s16-3 16-6V10M8 19c0 3 7 6 16 6s16-3 16-6M8 28c0 3 7 6 16 6s16-3 16-6"/>',
};
---

<section class="solutions-section" id="solutions">
  <div class="solutions-container">
    <h2 class="solutions-heading">SOLUTIONS</h2>

    <div class="solutions-grid">
      {solutions.map((solution) => (
        <a
          class="solution-card"
          href={solution.href}
          aria-label={`${solution.title}: ${solution.description}`}
        >
          <span class="solution-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <Fragment set:html={icons[solution.icon]} />
            </svg>
          </span>

          <h3 class="solution-title">{solution.title}</h3>
          <p class="solution-description">{solution.description}</p>
          <span class="solution-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

