---
import "@fortawesome/fontawesome-free/css/all.min.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import Solutions from "../components/Solutions.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AgentWorkflow from "../components/AgentWorkflow.astro";
---

<Layout>
  <Header />
  <HeroCarousel />
  <WhoWeAre />
  <HowItWorks />
  <AgentWorkflow />
  <Solutions />
  <FAQ />
  <Footer />

  <main>
    <section style="padding: 100px 5%; text-align: center;">
      <div role="heading" aria-level="1">
        Quality Engineering for a Smarter Digital Future
      </div>
      <p>
        Deliver reliable software experiences with modern testing solutions.
      </p>
      <a href="/contact/">Contact us</a>
    </section>

  </main>
</Layout>