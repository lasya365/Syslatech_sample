
---
import Layout from "../layouts/Layout.astro";
import "../styles/contact.css";
---

<Layout>
  <main class="contact-page">
    <h1 class="contact-page-heading">GET IN TOUCH</h1>

    <section class="contact-container">
      <div class="contact-form-panel">
        <h2>Send Us A Message</h2>
        <p class="contact-intro">
          Let's connect and explore the endless opportunities<br
            class="desktop-break"
          />
          to thrive in the digital world together!
        </p>

        <form id="contact-form" novalidate>
          <div class="form-field">
            <label for="contact-name">Name <span>*</span></label>
            <input
              id="contact-name"
              name="name"
              type="text"
              placeholder="Enter your Name"
              autocomplete="name"
              minlength="2"
              maxlength="60"
              required
            />
            <small class="field-error" id="name-error"></small>
          </div>

          <div class="form-field">
            <label for="contact-phone">Mobile Number <span>*</span></label>

            <div class="phone-row">
              <select
                id="country-code"
                name="countryCode"
                aria-label="Country calling code"
                required
              >
                <option value="+91" data-country="IN" selected>🇮🇳 +91 IN</option>
                <option value="+1" data-country="US">🇺🇸 +1 US/CA</option>
                <option value="+44" data-country="GB">🇬🇧 +44 GB</option>
                <option value="+61" data-country="AU">🇦🇺 +61 AU</option>
                <option value="+971" data-country="AE">🇦🇪 +971 AE</option>
                <option value="+65" data-country="SG">🇸🇬 +65 SG</option>
                <option value="+60" data-country="MY">🇲🇾 +60 MY</option>
                <option value="+64" data-country="NZ">🇳🇿 +64 NZ</option>
                <option value="+81" data-country="JP">🇯🇵 +81 JP</option>
                <option value="+49" data-country="DE">🇩🇪 +49 DE</option>
                <option value="+33" data-country="FR">🇫🇷 +33 FR</option>
                <option value="+39" data-country="IT">🇮🇹 +39 IT</option>
                <option value="+34" data-country="ES">🇪🇸 +34 ES</option>
                <option value="+31" data-country="NL">🇳🇱 +31 NL</option>
                <option value="+41" data-country="CH">🇨🇭 +41 CH</option>
                <option value="+46" data-country="SE">🇸🇪 +46 SE</option>
                <option value="+47" data-country="NO">🇳🇴 +47 NO</option>
                <option value="+45" data-country="DK">🇩🇰 +45 DK</option>
                <option value="+353" data-country="IE">🇮🇪 +353 IE</option>
                <option value="+351" data-country="PT">🇵🇹 +351 PT</option>
                <option value="+7" data-country="RU">🇷🇺 +7 RU/KZ</option>
                <option value="+86" data-country="CN">🇨🇳 +86 CN</option>
                <option value="+82" data-country="KR">🇰🇷 +82 KR</option>
                <option value="+62" data-country="ID">🇮🇩 +62 ID</option>
                <option value="+63" data-country="PH">🇵🇭 +63 PH</option>
                <option value="+66" data-country="TH">🇹🇭 +66 TH</option>
                <option value="+84" data-country="VN">🇻🇳 +84 VN</option>
                <option value="+92" data-country="PK">🇵🇰 +92 PK</option>
                <option value="+880" data-country="BD">🇧🇩 +880 BD</option>
                <option value="+977" data-country="NP">🇳🇵 +977 NP</option>
                <option value="+94" data-country="LK">🇱🇰 +94 LK</option>
                <option value="+966" data-country="SA">🇸🇦 +966 SA</option>
                <option value="+974" data-country="QA">🇶🇦 +974 QA</option>
                <option value="+965" data-country="KW">🇰🇼 +965 KW</option>
                <option value="+968" data-country="OM">🇴🇲 +968 OM</option>
                <option value="+973" data-country="BH">🇧🇭 +973 BH</option>
                <option value="+20" data-country="EG">🇪🇬 +20 EG</option>
                <option value="+27" data-country="ZA">🇿🇦 +27 ZA</option>
                <option value="+234" data-country="NG">🇳🇬 +234 NG</option>
                <option value="+254" data-country="KE">🇰🇪 +254 KE</option>
                <option value="+55" data-country="BR">🇧🇷 +55 BR</option>
                <option value="+52" data-country="MX">🇲🇽 +52 MX</option>
                <option value="+54" data-country="AR">🇦🇷 +54 AR</option>
              </select>

              <input
                id="contact-phone"
                name="phone"
                type="tel"
                placeholder="Enter your mobile number"
                autocomplete="tel-national"
                inputmode="numeric"
                minlength="7"
                maxlength="15"
                required
              />
            </div>
            <small class="field-error" id="phone-error"></small>
          </div>

          <div class="form-field">
            <label for="contact-email">Email Address <span>*</span></label>
            <input
              id="contact-email"
              name="email"
              type="email"
              placeholder="Enter your Email"
              autocomplete="email"
              maxlength="254"
              required
            />
            <small class="field-error" id="email-error"></small>
          </div>

          <div class="form-field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              placeholder="How can we help you?"
              maxlength="780"
              rows="5"
            ></textarea>
            <div class="character-count">
              <span id="message-count">0</span>/780
            </div>
          </div>

          <button class="contact-submit" type="submit">
            Send Message
          </button>

          <p
            id="contact-success"
            class="contact-success"
            role="status"
            aria-live="polite"
            hidden
          >
            Thank you for contacting us! Your details have been recorded
            in this form. Our team will contact you soon.
          </p>

          <p
            id="contact-failure"
            class="contact-failure"
            role="alert"
            hidden
          ></p>
        </form>
      </div>

      <aside class="contact-details">
        <div class="contact-detail">
          <span class="detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="14" rx="1" />
              <path d="m3 6 9 7 9-7" />
            </svg>
          </span>
          <div>
            <h3>Email</h3>
            <a href="mailto:sales@syslatech.com">sales@syslatech.com</a>
          </div>
        </div>

        <div class="contact-detail">
          <span class="detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M6.6 2.8 9.5 7 7.7 9.1c1.1 2.4 2.9 4.2 5.3 5.3l2.1-1.8 4.2 2.9-.7 4c-.1.7-.8 1.2-1.5 1.2C9.1 20.2 3.8 14.9 3.3 8.9c-.1-.7.4-1.4 1.2-1.5z"
              />
            </svg>
          </span>
          <div>
            <h3>Phone</h3>
            <a href="tel:+919986055536">+91 9986055536</a>
            <a href="tel:+17073145939">+1 707-314-5939</a>
          </div>
        </div>

        <div class="contact-detail">
          <span class="detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 22s7-7.1 7-13a7 7 0 1 0-14 0c0 5.9 7 13 7 13z"
              />
              <circle cx="12" cy="9" r="2.5" class="pin-hole" />
            </svg>
          </span>
          <div>
            <h3>Location</h3>
            <p>Bangalore, Karnataka, India</p>
          </div>
        </div>
      </aside>
    </section>
  </main>
</Layout>

<script>
  import "../scripts/contact.js";
</script>
