
---
import "../styles/stories.css";

const stories = [
  {
    name: "Anna Gunn",
    age: 7,
    location: "Hyderabad, India",
    title: "A brighter future for Anna",
    description:
      "With access to care and continued support, Anna is taking steps toward a healthier, happier future.",
    image:
      "https://images.unsplash.com/photo-1503919005314-30d93d07d823?auto=format&fit=crop&w=900&q=85",
    raised: 85000,
    goal: 120000,
  },
  {
    name: "Maya Sharma",
    age: 9,
    location: "Chennai, India",
    title: "Helping Maya dream again",
    description:
      "Your support can help Maya and her family access the care and resources they need.",
    image:
      "https://images.unsplash.com/photo-1484820540004-14229fe36ca4?auto=format&fit=crop&w=900&q=85",
    raised: 62000,
    goal: 100000,
  },
  {
    name: "Annie Gunn",
    age: 7,
    location: "Hyderabad, India",
    title: "A journey filled with hope",
    description:
      "Every small act of kindness brings Annie one step closer to a brighter tomorrow. Join her journey by helping provide the care and support she needs.",
    image:
      "https://images.unsplash.com/photo-1516627145497-ae6968895b74?auto=format&fit=crop&w=1000&q=90",
    raised: 85000,
    goal: 120000,
  },
  {
    name: "Sara Wilson",
    age: 8,
    location: "Bengaluru, India",
    title: "Together, we can make a difference",
    description:
      "Community support gives Sara and her family renewed confidence and hope for the future.",
    image:
      "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=900&q=85",
    raised: 54000,
    goal: 90000,
  },
  {
    name: "Meera Rao",
    age: 6,
    location: "Vijayawada, India",
    title: "Small steps, big possibilities",
    description:
      "With the right support, Meera can keep moving toward a future full of possibilities.",
    image:
      "https://images.unsplash.com/photo-1471286174890-9c112ffca5b4?auto=format&fit=crop&w=900&q=85",
    raised: 47000,
    goal: 80000,
  },
];

const formatAmount = (amount: number) =>
  new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 0,
  }).format(amount);
---

<section class="stories-section" id="stories">
  <div class="stories-heading">
    <div>
      <p class="stories-eyebrow">REAL PEOPLE. REAL STORIES.</p>

      <h2>
        Inspiring Journeys<br />
        of Strength and Hope
      </h2>

      <p class="stories-intro">
        Every journey tells a story. Discover the people whose lives can be
        changed through kindness, care, and community support.
      </p>
    </div>

    <a class="stories-all-link" href="/stories/">
      See all stories <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div
    class="stories-carousel"
    aria-label="Featured stories carousel"
    aria-roledescription="carousel"
    tabindex="0"
  >
    <div class="stories-track">
      {stories.map((story) => {
        const progress = Math.min(
          100,
          Math.round((story.raised / story.goal) * 100),
        );

        const storySlug = story.name.toLowerCase().replaceAll(" ", "-");

        return (
          <article class="story-card">
            <a
              class="story-image-link"
              href={`/stories/${storySlug}/`}
              aria-label={`Read ${story.name}'s story`}
              draggable="false"
            >
              <img
                class="story-image"
                src={story.image}
                alt={`Portrait representing ${story.name}'s story`}
                loading="lazy"
                draggable="false"
              />

              <span class="story-image-label">A STORY OF HOPE</span>
            </a>

            <div class="story-content">
              <div class="story-person">
                <div>
                  <h3>{story.name}, {story.age}</h3>
                  <p class="story-location">{story.location}</p>
                </div>

                <button
                  class="story-heart"
                  type="button"
                  aria-label={`Show support for ${story.name}`}
                  data-story-name={story.name}
                >
                  ♡
                </button>
              </div>

              <h4>{story.title}</h4>

              <p class="story-description">{story.description}</p>

              <div class="story-progress-labels">
                <span>{formatAmount(story.raised)} raised</span>
                <span>{progress}%</span>
              </div>

              <div
                class="story-progress"
                role="progressbar"
                aria-label={`Fundraising progress for ${story.name}`}
                aria-valuenow={progress}
                aria-valuemin={0}
                aria-valuemax={100}
              >
                <span style={`width: ${progress}%`}></span>
              </div>

              <div class="story-card-footer">
                <span>Goal: {formatAmount(story.goal)}</span>

                <a
                  href={`/stories/${storySlug}/`}
                  class="story-read-link"
                >
                  Read story <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <div class="stories-bottom">
    <p>Every story deserves a chance to shine.</p>

    <a href="/stories/" class="stories-button">
      Explore all stories <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<script>
  import "../scripts/stories-carousel.js";
</script>
